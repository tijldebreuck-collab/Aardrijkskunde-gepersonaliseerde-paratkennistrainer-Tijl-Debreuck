rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} { 
      allow read, write: if false; 
    }

    // Hardened users document access
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isValidUser(data) {
        return data.keys().hasAll(['createdAt', 'preferences', 'geoStats', 'geoProgress'])
          && data.createdAt is string
          && data.preferences is map
          && data.geoStats is map
          && data.geoProgress is map;
      }

      // Read is only allowed for the owner
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      // Creation & updates allowed for owner
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
  }
}
